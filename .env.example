# Public Supabase settings safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI provider settings.
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_VISION_MODEL=
AI_TEXT_MODEL=
AI_IMAGE_MODEL=

NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_DAILY_USER_REQUEST_LIMIT=20
AI_MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
